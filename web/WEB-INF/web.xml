<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
    
    <display-name>Leave Management System</display-name>
    
    <!-- Welcome Files -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>AddEmployeeServlet</servlet-name>
        <servlet-class>controller.AddEmployeeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddEmployeeServlet</servlet-name>
        <url-pattern>/add-employee</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>EmployeeListServlet</servlet-name>
        <servlet-class>controller.EmployeeListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmployeeListServlet</servlet-name>
        <url-pattern>/employee-list</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>DeleteEmployeeServlet</servlet-name>
        <servlet-class>controller.DeleteEmployeeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteEmployeeServlet</servlet-name>
        <url-pattern>/delete-employee</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>UserProfileServlet</servlet-name>
        <servlet-class>controller.UserProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserProfileServlet</servlet-name>
        <url-pattern>/user-profile</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>CreateLeaveRequestServlet</servlet-name>
        <servlet-class>controller.CreateLeaveRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateLeaveRequestServlet</servlet-name>
        <url-pattern>/create-leave-request</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>MyLeaveRequestsServlet</servlet-name>
        <servlet-class>controller.MyLeaveRequestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyLeaveRequestsServlet</servlet-name>
        <url-pattern>/my-leave-requests</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>PendingRequestsServlet</servlet-name>
        <servlet-class>controller.PendingRequestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PendingRequestsServlet</servlet-name>
        <url-pattern>/pending-requests</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>AllRequestsServlet</servlet-name>
        <servlet-class>controller.AllRequestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AllRequestsServlet</servlet-name>
        <url-pattern>/all-requests</url-pattern>
    </servlet-mapping>
    
    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
    
</web-app>